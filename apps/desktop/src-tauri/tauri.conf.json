{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Local-first AI Video Studio",
  "version": "0.1.0",
  "identifier": "com.localfirst.aivideostudio",
  "build": { "beforeDevCommand": "cd ../web && npm run dev -- --host 127.0.0.1", "beforeBuildCommand": "cd ../web && npm run build", "devUrl": "http://localhost:5173", "frontendDist": "../../web/build" },
  "app": {
    "withGlobalTauri": false,
    "security": { "csp": "default-src 'self'; media-src 'self' blob:; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'" },
    "windows": [{ "label": "main", "title": "Local-first AI Video Studio", "width": 1280, "height": 800, "dragDropEnabled": true }]
  },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/icon.png", "icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png"], "resources": { "../../../scripts": "scripts", "../../../adapters": "adapters", "../../../packages": "packages", "../../../services": "services", "./resources/node": "node", "./resources/ffmpeg": "ffmpeg", "./resources/ffprobe": "ffprobe" }, "createUpdaterArtifacts": false }
}
