{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Local-first AI Video Studio",
  "version": "0.1.0",
  "identifier": "com.localfirst.aivideostudio",
  "build": {
    "beforeDevCommand": "cd ../web && npm run dev -- --host 127.0.0.1",
    "beforeBuildCommand": "cd ../web && npm ci && npm run build && npm run build:node",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../web/build"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; media-src 'self' blob:; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'; frame-src https://www.youtube.com https://www.youtube-nocookie.com http://localhost:14872"
    },
    "windows": [
      {
        "label": "main",
        "title": "Local-first AI Video Studio",
        "width": 1280,
        "height": 800,
        "dragDropEnabled": true,
        "decorations": false
      }
    ],
    "enableGTKAppId": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "resources": {
      "../../../scripts": "scripts",
      "../../../adapters": "adapters",
      "../../../packages": "packages",
      "../../../services": "services",
      "../../web/build-node": "build-node",
      "./resources/node": "node",
      "./resources/ffmpeg*": "",
      "./resources/ffprobe*": "",
      "./resources/llama": "llama",
      "./resources/models": "models",
      "./resources/models/llama": "models/llama"
    },
    "createUpdaterArtifacts": false
  }
}
